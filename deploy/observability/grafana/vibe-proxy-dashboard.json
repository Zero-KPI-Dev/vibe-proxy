      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum(rate(vibe_proxy_requests_total{model=~\"$model\",channel=~\"$channel\",status=~\"[45]..\"}[$__rate_interval])) / clamp_min(sum(rate(vibe_proxy_requests_total{model=~\"$model\",channel=~\"$channel\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "",
          "range": true,
          "refId": "A"
        }
